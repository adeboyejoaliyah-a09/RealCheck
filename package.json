{
  "name": "realcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"const fs=require('fs'); const {spawnSync}=require('child_process'); fs.rmSync('.next',{recursive:true,force:true}); const result=spawnSync(process.execPath,['./node_modules/next/dist/bin/next','dev'],{stdio:'inherit'}); process.exit(result.status ?? 0);\"",
    "build": "node -e \"const fs=require('fs'); fs.rmSync('.next',{recursive:true,force:true});\" && next build",
    "start": "next start",
    "lint": "next lint",
    "local": "node server.mjs"
  },
  "dependencies": {
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "@supabase/supabase-js": "^2.75.0",
    "twilio": "^5.10.3"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18"
  }
}
